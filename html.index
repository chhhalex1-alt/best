<a href="#contact">Contact</a>
</nav>
</header>

<section id="home" class="hero">
<h2>Performance. Style. Power.</h2>
<button class="star-btn">Programeaza</button>
</section>

<section id="galerie">
<h2>Galerie</h2>
<div class="gallery">
<img src="https://images.unsplash.com/photo-1617531653332-bd46c24f2068">
