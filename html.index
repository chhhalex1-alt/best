<body>

<canvas id="bg"></canvas>
<canvas id="sparkCanvas"></canvas>

<header class="navbar">
<h1>G-Tunning</h1>
<nav>
<a href="#home">Acasa</a>
<a href="#galerie">Galerie</a>
